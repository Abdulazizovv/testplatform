###############################################
# PRODUCTION DEPLOYMENT CONFIGURATION
# This is a template for production .env files.
# Copy to .env and fill in the CHANGE_ME values.
###############################################

###############################################
# Django Settings
###############################################
# REQUIRED: Secret key for cryptographic signing.
# Must be 50+ characters, unique per environment, and NEVER shared or leaked.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME

# MUST be False in production (enables DEBUG mode, SQL query logging, detailed error pages).
DJANGO_DEBUG=False

# Comma-separated list of domain names allowed to serve requests.
# Examples: "example.com,www.example.com" or "app.example.com"
# localhost, 127.0.0.1, and "backend" are always allowed automatically (for container health checks
# and internal calls). Set this to your actual production domain(s).
DJANGO_ALLOWED_HOSTS=<DOMAIN>,www.<DOMAIN>

# Exact origins (scheme + hostname) that are allowed to submit forms (CSRF protection).
# MUST match your production domain scheme (https://) and be an exact origin.
# Example: https://example.com
CSRF_TRUSTED_ORIGINS=https://<DOMAIN>

# MUST be True in production. Django will:
# - Enforce secure cookies (Secure flag)
# - Redirect all HTTP requests to HTTPS
# - Set HSTS headers (strict-transport-security)
# TLS termination happens at the host nginx, not in this container.
DJANGO_SECURE_SSL=True

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Use INFO or WARNING in production to reduce log volume.
DJANGO_LOG_LEVEL=INFO

###############################################
# Database (PostgreSQL)
###############################################
# Database name for the platform.
POSTGRES_DB=testplatform

# Database superuser name. Keep this value the same if the volume already exists;
# changing it after initial setup has no effect (the user already exists in the volume).
POSTGRES_USER=testplatform

# Database superuser password.
# REQUIRED: Generate a strong, random password. The database applies this ONLY on first volume creation.
# Once the volume exists, changing this value has no effect — you must alter the user inside Postgres
# or destroy the volume (docker compose down -v) and recreate it, losing all data.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=CHANGE_ME

###############################################
# Redis / Celery
###############################################
# These are set automatically by docker-compose.yml from the service configuration.
# Leave these empty; compose will inject the correct values at runtime.
REDIS_URL=
CELERY_BROKER_URL=

###############################################
# Security & Rate Limiting
###############################################
# Login brute-force protection: lock a username+IP pair after N failed attempts.
AXES_FAILURE_LIMIT=5

# Cooloff period (minutes) before a locked account is unlocked automatically.
AXES_COOLOFF_MINUTES=15

###############################################
# gunicorn (Application Server)
###############################################
# Number of worker processes. Recommended: 2-4 per CPU core.
# For a 2-core VPS: use 4-8. Monitor CPU/memory and adjust.
GUNICORN_WORKERS=4

# Worker timeout (seconds): max time a request is allowed to run before being killed.
# Set high enough for slow operations (file uploads, large queries), but low enough
# to recover from hangs (default 60s is reasonable).
GUNICORN_TIMEOUT=60

# Graceful shutdown timeout: wait this long for workers to finish requests before forcing restart.
GUNICORN_GRACEFUL_TIMEOUT=30

# Max requests per worker before it is recycled (prevents memory leaks in long-running processes).
GUNICORN_MAX_REQUESTS=1000

# Random jitter on max_requests to avoid all workers restarting at once.
GUNICORN_MAX_REQUESTS_JITTER=100

###############################################
# nginx (Reverse Proxy)
###############################################
# Port on which the Docker container's nginx listens (loopback only: 127.0.0.1).
# The host's own nginx reverse-proxies the real domain to this port.
# Must match the port in docker-compose.yml and the host nginx config.
NGINX_PORT=7788

###############################################
# DEPLOYMENT CHECKLIST
###############################################
# Before deploying to production:
#
# 1. Fill in all CHANGE_ME values above.
# 2. Ensure DJANGO_SECURE_SSL=True.
# 3. Set DJANGO_ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS to your real domain.
# 4. Generate new DJANGO_SECRET_KEY and POSTGRES_PASSWORD (do not reuse from dev).
# 5. Review docs/DEPLOYMENT.md for complete setup steps.
# 6. Run `docker compose config` to verify no validation errors.
# 7. Verify the host nginx config is in place (TLS certificates, proxy rules).
# 8. After `docker compose up`, run migrations: `docker compose exec backend python manage.py migrate`
# 9. Create a superadmin: `docker compose exec backend python manage.py createsuperuser`
# 10. Test the health endpoints: curl -i https://<your-domain>/healthz/
#
# NEVER commit this file to version control. Each environment gets its own .env with real secrets.
