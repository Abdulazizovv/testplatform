###############################################
# One .env at the repo root configures everything (Django, Postgres, compose).
# Copy it:  cp .env.example .env   and fill in the CHANGE_ME values.
###############################################

###############################################
# Django
###############################################
# Required, 50+ chars, unique per environment. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The backend refuses to start with DEBUG=False and a short/placeholder key.
DJANGO_SECRET_KEY=CHANGE_ME
# Keep False everywhere except a throwaway local dev machine.
DJANGO_DEBUG=False
# Comma-separated public host names, e.g. "<your-domain>,www.<your-domain>".
# "localhost", "127.0.0.1" and "backend" are always allowed automatically (the Docker
# HEALTHCHECK and the frontend's server-side calls need them) - no need to list them.
DJANGO_ALLOWED_HOSTS=
# Exact origins (scheme + host) allowed to POST with the session cookie, comma-separated.
#   Production:                 https://<your-domain>
#   Local docker (nginx port):  http://localhost:7788
#   Local `npm run dev`:        http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:7788
# Secure cookies + HTTPS redirect + HSTS (TLS is terminated by the host nginx).
# Set to False ONLY to try the compose stack over plain http://localhost:7788.
# MUST be True in production.
DJANGO_SECURE_SSL=True
DJANGO_LOG_LEVEL=INFO

# Login brute-force protection (django-axes): lock a username+IP pair after N failures.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# gunicorn (optional tuning)
GUNICORN_WORKERS=3

###############################################
# Database
###############################################
# Local dev without Docker: leave DATABASE_URL unset to fall back to SQLite.
# docker-compose.yml assembles DATABASE_URL itself from the three values below.
POSTGRES_DB=testplatform
POSTGRES_USER=testplatform
POSTGRES_PASSWORD=CHANGE_ME

###############################################
# Redis / Celery
###############################################
# Set automatically by docker-compose.yml for the backend and celery containers
# (cache db 0, Celery broker db 1). Local dev without Docker: leave both unset
# (in-memory cache, Celery tasks run inline).
REDIS_URL=
CELERY_BROKER_URL=

###############################################
# nginx
###############################################
# Host port the project's nginx (loopback-only, 127.0.0.1) binds to. The host nginx
# that holds the TLS certs reverse-proxies the real domain to this port.
NGINX_PORT=7788
